#!/usr/bin/env python3
"""
convert-sam-for-rsem - Make a RSEM compatible BAM file.

Converts SAM/BAM/CRAM from user's aligner into a BAM file which RSEM can process.
Users must ensure aligners use 'reference_name.idx.fa' from rsem-prepare-reference.
After conversion, calls rsem-sam-validator to validate the resulting BAM file.

Note: You do not need to run this script if rsem-sam-validator reports that
your SAM/BAM/CRAM file is valid.
"""

import argparse
import os
import sys

_script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _script_dir)
os.environ["PATH"] = os.pathsep.join([
    _script_dir,
    os.path.join(_script_dir, "samtools-1.3"),
    os.environ.get("PATH", ""),
])

from rsem_utils import run_command


def main():
    parser = argparse.ArgumentParser(
        description="Make a RSEM compatible BAM file.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  convert-sam-for-rsem input.sam output

  We will get a file called 'output.bam' as output.
        """,
    )
    parser.add_argument(
        "-p", "--num-threads",
        type=int,
        default=1,
        help="Set the number of threads to be used for converting. (Default: 1)",
    )
    parser.add_argument(
        "--memory-per-thread",
        default="1G",
        help="Set the maximum allowable memory per thread. Accepts suffices K/M/G. (Default: 1G)",
    )
    parser.add_argument(
        "input_file",
        help="Input SAM/BAM/CRAM file from aligner (must contain header section)",
    )
    parser.add_argument(
        "output_name",
        help="Output base name. Script will create output_name.bam",
    )

    args = parser.parse_args()

    in_file = args.input_file
    tmp_file = f"{args.output_name}.tmp.bam"
    out_file = f"{args.output_name}.bam"

    # Phase I: sort entries so all entries of same read group together
    cmd = f"samtools sort -n -@ {args.num_threads} -m {args.memory_per_thread} -o {tmp_file} {in_file}"
    run_command(cmd)

    # Phase II: parse temporary BAM to make paired-end alignments' two mates adjacent
    cmd = f"rsem-scan-for-paired-end-reads {args.num_threads} {tmp_file} {out_file}"
    run_command(cmd)

    # Delete temporary file
    try:
        os.unlink(tmp_file)
    except OSError as e:
        sys.exit(f"Could not delete {tmp_file}: {e}")

    print(f"Conversion is completed. {out_file} will be checked by 'rsem-sam-validator'.")

    # Phase III: validate resulting BAM file
    cmd = f"rsem-sam-validator {out_file}"
    run_command(cmd)


if __name__ == "__main__":
    main()
