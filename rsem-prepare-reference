#!/usr/bin/env python3
"""
rsem-prepare-reference - Prepare transcript references for RSEM and optionally build
BOWTIE/BOWTIE2/STAR/HISAT2 indices.
"""

import argparse
import glob
import os
import sys

_script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _script_dir)
os.environ["PATH"] = os.pathsep.join([_script_dir, os.environ.get("PATH", "")])

from rsem_utils import run_command


def main():
    parser = argparse.ArgumentParser(
        description="Prepare transcript references for RSEM and optionally build aligner indices.",
    )
    parser.add_argument("--gtf", default="", help="GTF annotation file for genome extraction.")
    parser.add_argument("--gff3", default="", help="GFF3 annotation (converted to GTF).")
    parser.add_argument("--gff3-RNA-patterns", default="", help="Comma-separated transcript categories for GFF3.")
    parser.add_argument("--gff3-genes-as-transcripts", action="store_true", help="Treat genes as transcripts in GFF3.")
    parser.add_argument("--trusted-sources", default="None", help="Comma-separated trusted sources.")
    parser.add_argument("--transcript-to-gene-map", default="", help="Transcript-to-gene mapping file.")
    parser.add_argument("--allele-to-gene-map", default="", help="Allele-to-gene mapping file.")
    parser.add_argument("--polyA", action="store_true", help="Add poly(A) tails to all isoforms.")
    parser.add_argument("--polyA-length", type=int, default=125, help="Poly(A) tail length.")
    parser.add_argument("--no-polyA-subset", default="", help="Transcripts to exclude from poly(A).")
    parser.add_argument("--bowtie", action="store_true", help="Build Bowtie indices.")
    parser.add_argument("--bowtie-path", default="", help="Path to Bowtie executables.")
    parser.add_argument("--bowtie2", action="store_true", help="Build Bowtie 2 indices.")
    parser.add_argument("--bowtie2-path", default="", help="Path to Bowtie 2 executables.")
    parser.add_argument("--star", action="store_true", help="Build STAR indices.")
    parser.add_argument("--star-path", default="", help="Path to STAR executable.")
    parser.add_argument("--star-sjdboverhang", type=int, default=100, help="STAR sjdbOverhang.")
    parser.add_argument(
        "--star-genome-sa-index-nbases",
        type=int,
        default=0,
        help="If set with --star, passed to STAR as --genomeSAindexNbases (e.g. 6–8 for very small genomes). 0 = omit.",
    )
    parser.add_argument("--hisat2-hca", action="store_true", help="Build HISAT2 HCA indices.")
    parser.add_argument("--hisat2-path", default="", help="Path to HISAT2 executables.")
    parser.add_argument("-p", "--num-threads", type=int, default=1, help="Threads for STAR.")
    parser.add_argument("--prep-pRSEM", action="store_true", help="Prepare reference for pRSEM.")
    parser.add_argument("--mappability-bigwig-file", default="", help="Mappability bigWig file for pRSEM.")
    parser.add_argument("-q", "--quiet", action="store_true", help="Suppress logging.")
    parser.add_argument("reference_fasta", help="Comma-separated FASTA files or directory.")
    parser.add_argument("reference_name", help="Output reference name (can include path).")
    args = parser.parse_args()

    if args.transcript_to_gene_map and args.allele_to_gene_map:
        parser.error("--transcript-to-gene-map and --allele-to-gene-map are mutually exclusive!")
    if args.gtf and args.gff3:
        parser.error("--gtf and --gff3 are mutually exclusive!")
    if (args.gtf or args.gff3) and args.allele_to_gene_map:
        parser.error("--gtf/--gff3 and --allele-to-gene-map are mutually exclusive!")
    if args.star and args.polyA:
        parser.error("No poly(A) tail should be added if --star is set!")
    if args.star_genome_sa_index_nbases > 0 and not args.star:
        parser.error("--star-genome-sa-index-nbases requires --star!")
    if args.star_genome_sa_index_nbases > 0 and (
        args.star_genome_sa_index_nbases < 2 or args.star_genome_sa_index_nbases > 16
    ):
        parser.error("--star-genome-sa-index-nbases must be between 2 and 16!")

    if args.prep_pRSEM:
        if not args.bowtie_path:
            parser.error("--bowtie-path <path> needs to be specified for preparing pRSEM references")
        if not args.mappability_bigwig_file:
            parser.error("--mappability-bigwig-file <string> needs to be specified for preparing pRSEM references")

    if not args.bowtie and args.bowtie_path:
        print("Warning: If Bowtie is not used, no need to set --bowtie-path option!")
    if not args.bowtie2 and args.bowtie2_path:
        print("Warning: If Bowtie 2 is not used, no need to set --bowtie2-path option!")
    if not args.star and args.star_path:
        print("Warning: If STAR is not used, no need to set --star-path option!")
    if not args.hisat2_hca and args.hisat2_path:
        print("Warning: If HISAT2 is not used, no need to set --hisat2-path option!")

    # Parse reference files
    ref_input = args.reference_fasta
    if "," in ref_input:
        fasta_list = [f.strip() for f in ref_input.split(",")]
    else:
        fasta_list = [ref_input]

    if len(fasta_list) == 1 and os.path.isdir(fasta_list[0]):
        d = fasta_list[0]
        fasta_list = glob.glob(os.path.join(d, "*.fa")) + glob.glob(os.path.join(d, "*.fasta"))

    if not fasta_list:
        parser.error("reference_fasta_file(s) is empty! Please check if you provide the correct folder name or file suffixes!")

    poly_a_choice = 1  # 0=polyA all, 1=no polyA, 2=no polyA subset
    if args.polyA:
        poly_a_choice = 2 if args.no_polyA_subset else 0

    bowtie_path = (args.bowtie_path.rstrip("/") + "/") if args.bowtie_path else ""
    bowtie2_path = (args.bowtie2_path.rstrip("/") + "/") if args.bowtie2_path else ""
    star_path = (args.star_path.rstrip("/") + "/") if args.star_path else ""
    hisat2_path = (args.hisat2_path.rstrip("/") + "/") if args.hisat2_path else ""

    ref_name = args.reference_name
    quiet = "1" if args.quiet else "0"
    fasta_str = " ".join(fasta_list)

    # GFF3 to GTF conversion
    if args.gff3:
        gtf_file = f"{ref_name}.gtf"
        if os.path.exists(gtf_file):
            parser.error(f"A file with the name {gtf_file} already exists! GFF3-to-GTF conversion failed!")
        cmd = "rsem-gff3-to-gtf"
        if args.gff3_RNA_patterns:
            cmd += f" --RNA-patterns {args.gff3_RNA_patterns}"
        if args.gff3_genes_as_transcripts:
            cmd += " --make-genes-as-transcripts"
        cmd += f" {args.gff3} {gtf_file}"
        run_command(cmd)
    else:
        gtf_file = args.gtf

    # Extract or synthesize reference transcripts
    if gtf_file:
        gtf_sources = args.trusted_sources.replace(" ", "\\ ")
        cmd = f"rsem-extract-reference-transcripts {ref_name} {quiet} {gtf_file} {gtf_sources}"
        if args.transcript_to_gene_map:
            cmd += f" 1 {args.transcript_to_gene_map}"
        else:
            cmd += " 0"
        cmd += f" {fasta_str}"
        run_command(cmd)
    else:
        cmd = f"rsem-synthesis-reference-transcripts {ref_name} {quiet}"
        if args.transcript_to_gene_map:
            cmd += f" 1 {args.transcript_to_gene_map}"
        elif args.allele_to_gene_map:
            cmd += f" 2 {args.allele_to_gene_map}"
        else:
            cmd += " 0"
        cmd += f" {fasta_str}"
        run_command(cmd)

    # rsem-preref
    cmd = f"rsem-preref {ref_name}.transcripts.fa {poly_a_choice} {ref_name}"
    if poly_a_choice != 1:
        cmd += f" -l {args.polyA_length}"
    if poly_a_choice == 2:
        cmd += f" -f {args.no_polyA_subset}"
    if args.quiet:
        cmd += " -q"
    run_command(cmd)

    # Build aligner indices
    if args.bowtie:
        cmd = f"{bowtie_path}bowtie-build -f"
        if args.quiet:
            cmd += " -q"
        cmd += f" {ref_name}.n2g.idx.fa {ref_name}"
        run_command(cmd)

    if args.bowtie2:
        cmd = f"{bowtie2_path}bowtie2-build -f"
        if args.num_threads > 1:
            cmd += f" --threads {args.num_threads}"
        if args.quiet:
            cmd += " -q"
        cmd += f" {ref_name}.idx.fa {ref_name}"
        run_command(cmd)

    if args.star:
        if not gtf_file:
            parser.error("Sorry, if you want RSEM run STAR for you, you must provide the genome sequence and associated GTF annotation.")
        out_star_genome_path = os.path.dirname(ref_name)
        cmd = (
            f"{star_path}STAR --runThreadN {args.num_threads} "
            f"--runMode genomeGenerate --genomeDir {out_star_genome_path} "
            f"--genomeFastaFiles {fasta_str} --sjdbGTFfile {gtf_file} "
            f"--sjdbOverhang {args.star_sjdboverhang} "
        )
        if args.star_genome_sa_index_nbases > 0:
            cmd += f"--genomeSAindexNbases {args.star_genome_sa_index_nbases} "
        cmd += f"--outFileNamePrefix {ref_name}"
        run_command(cmd)

    if args.hisat2_hca:
        cmd = f"{hisat2_path}hisat2-build -f"
        if args.num_threads > 1:
            cmd += f" -p {args.num_threads}"
        if args.quiet:
            cmd += " -q"
        cmd += f" {ref_name}.idx.fa {ref_name}"
        run_command(cmd)

    if args.prep_pRSEM:
        # Get chromosomes from GTF
        chrom2exists = set()
        with open(gtf_file) as f:
            for line in f:
                chrom2exists.add(line.split("\t")[0])

        reflist = []
        for fullname in fasta_list:
            basename = os.path.basename(fullname)
            for suf in (".fa", ".fasta"):
                if basename.endswith(suf):
                    basename = basename[: -len(suf)]
                    break
            if basename in chrom2exists:
                reflist.append(fullname)

        ref_fas = ",".join(reflist)
        cmd = (
            f"{_script_dir}/pRSEM/prsem-prepare-reference "
            f"--num-threads {args.num_threads} --bowtie-path {bowtie_path} "
            f"--mappability-bigwig-file {args.mappability_bigwig_file}"
        )
        if args.quiet:
            cmd += " --quiet"
        cmd += f" {ref_fas} {ref_name}"
        run_command(cmd)


if __name__ == "__main__":
    main()
