#!/usr/bin/env python3
"""
rsem-control-fdr - Filter EBSeq output for statistical significance.

Controls false discovery rate and reports differentially expressed genes/transcripts.
Input should be the main result file from rsem-run-ebseq.
"""

import argparse
import sys


def main():
    parser = argparse.ArgumentParser(
        description="Filter EBSeq output for statistical significance.",
    )
    parser.add_argument(
        "--hard-threshold",
        action="store_true",
        help="Only report genes/transcripts with PPDE >= 1 - fdr_rate. (Default)",
    )
    parser.add_argument(
        "--soft-threshold",
        action="store_true",
        help="Report as many as possible with average PPDE >= 1 - fdr_rate.",
    )
    parser.add_argument(
        "input_file",
        help="Main result file from rsem-run-ebseq",
    )
    parser.add_argument(
        "fdr_rate",
        type=float,
        help="Desired false discovery rate",
    )
    parser.add_argument(
        "output_file",
        help="Output file with DE genes/transcripts only",
    )
    args = parser.parse_args()

    if args.hard_threshold and args.soft_threshold:
        parser.error("--hard-threshold and --soft-threshold cannot be set at the same time!")

    hard = args.hard_threshold or (not args.soft_threshold)

    try:
        with open(args.input_file) as f:
            header = f.readline().rstrip("\n")
            columns = header.split("\t")

        pos = 0
        while pos < len(columns) and columns[pos] != '"PPDE"':
            pos += 1
        if pos >= len(columns):
            print("Error: Cannot find column PPDE!", file=sys.stderr)
            sys.exit(-1)
        pde_pos = pos

        n = 0
        total_ppee = 0.0

        with open(args.input_file) as inp, open(args.output_file, "w") as out:
            header = inp.readline().rstrip("\n")
            out.write(header + "\n")

            for line in inp:
                line = line.rstrip("\n")
                fields = line.split("\t")
                ppee = 1.0 - float(fields[pde_pos])

                if hard:
                    if ppee > args.fdr_rate:
                        break
                else:
                    if total_ppee + ppee > args.fdr_rate * (n + 1):
                        break
                    total_ppee += ppee

                n += 1
                out.write(line + "\n")

        print(f"There are {n} genes/transcripts reported at FDR = {args.fdr_rate}.")

    except OSError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(-1)


if __name__ == "__main__":
    main()
