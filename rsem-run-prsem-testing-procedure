#!/usr/bin/env python3
"""
rsem-run-prsem-testing-procedure - Run pRSEM testing procedure for prior-enhanced RSEM.

Provides p-value and log-likelihood to determine whether external data set(s)
is informative for RNA-seq quantification.
"""

import argparse
import os
import sys

_script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _script_dir)
os.environ["PATH"] = os.pathsep.join([
    _script_dir,
    os.path.join(_script_dir, "sam"),
    os.environ.get("PATH", ""),
])

from rsem_utils import run_command, show_version_info


def main():
    parser = argparse.ArgumentParser(
        description="Run pRSEM testing procedure for prior-enhanced RSEM.",
    )
    parser.add_argument(
        "--keep-intermediate-files",
        action="store_true",
        help="Keep temporary files. (Default: off)",
    )
    parser.add_argument(
        "--temporary-folder",
        default="",
        help="Where to put temporary files. (Default: sample_name.temp)",
    )
    parser.add_argument(
        "--bowtie-path",
        default="",
        help="Path to Bowtie executables.",
    )
    parser.add_argument(
        "--chipseq-target-read-files",
        default="",
        help="Comma-separated FASTQ files for ChIP-seq target.",
    )
    parser.add_argument(
        "--chipseq-control-read-files",
        default="",
        help="Comma-separated FASTQ files for ChIP-seq control.",
    )
    parser.add_argument(
        "--chipseq-read-files-multi-targets",
        default="",
        help="Comma-separated FASTQ files for multiple ChIP-seq targets.",
    )
    parser.add_argument(
        "--chipseq-bed-files-multi-targets",
        default="",
        help="Comma-separated BED files for multiple ChIP-seq targets.",
    )
    parser.add_argument(
        "--chipseq-peak-file",
        default="",
        help="ChIP-seq peak file (narrowPeak/BED6+4 format).",
    )
    parser.add_argument(
        "--partition-model",
        default="pk",
        choices=["pk", "cmb_lgt"],
        help="Partition model: pk or cmb_lgt. (Default: pk)",
    )
    parser.add_argument(
        "-p", "--num-threads",
        type=int,
        default=1,
        help="Number of threads. (Default: 1)",
    )
    parser.add_argument(
        "--version",
        action="store_true",
        help="Show version information.",
    )
    parser.add_argument(
        "-q", "--quiet",
        action="store_true",
        help="Suppress logging. (Default: off)",
    )
    parser.add_argument(
        "reference_name",
        help="Reference name (from rsem-prepare-reference with --prep-pRSEM)",
    )
    parser.add_argument(
        "sample_name",
        help="Sample name (from rsem-calculate-expression with --calc-pme)",
    )
    args = parser.parse_args()

    if args.version:
        show_version_info()

    # Validate parameters
    msg = ""
    if not args.chipseq_peak_file and (
        (not args.chipseq_target_read_files or not args.chipseq_control_read_files or not args.bowtie_path)
        and (not args.chipseq_read_files_multi_targets or not args.bowtie_path)
        and not args.chipseq_bed_files_multi_targets
    ):
        msg = (
            "please define one set of the following options to run pRSEM's testing procedure:\n"
            "1. --chipseq-peak-file <file>\n"
            "2. --chipseq-target-read-files <file> and\n"
            "   --chipseq-control-read-files <file> and\n"
            "   --bowtie-path <path>\n"
            "3. --chipseq-read-files-multi-targets <files> and\n"
            "   --bowtie-path <path>\n"
            "4. --chipseq-bed-files-multi-targets <files>\n"
        )

    if args.partition_model == "cmb_lgt" and not args.chipseq_read_files_multi_targets and not args.chipseq_bed_files_multi_targets:
        msg = (
            "either --chipseq-read-files-multi-targets <files> or "
            "--chipseq-bed-files-multi-targets <files> needs to be "
            f"defined for pRSEM's partition model: '{args.partition_model}'"
        )
    elif args.partition_model not in ("pk", "cmb_lgt"):
        if (not args.chipseq_target_read_files or not args.chipseq_control_read_files or not args.bowtie_path):
            msg = (
                "--chipseq-target-read-files <file> and "
                "--chipseq-control-read-files <file> and "
                "--bowtie-path <path> need to be defined for "
                f"pRSEM's partition model: '{args.partition_model}'"
            )

    if msg:
        parser.error(msg)

    partition_model = args.partition_model
    if partition_model != "cmb_lgt" and (args.chipseq_read_files_multi_targets or args.chipseq_bed_files_multi_targets):
        print("\nCombining signals from multiple sources, partition model is set to 'cmb_lgt'\n")
        partition_model = "cmb_lgt"

    ref_name = args.reference_name
    sample_name = args.sample_name
    sample_token = sample_name.split("/")[-1] if "/" in sample_name else sample_name

    temp_dir = args.temporary_folder or f"{sample_name}.temp"
    stat_dir = f"{sample_name}.stat"

    os.makedirs(temp_dir, exist_ok=True)
    os.makedirs(stat_dir, exist_ok=True)

    imd_name = f"{temp_dir}/{sample_token}"
    stat_name = f"{stat_dir}/{sample_token}"

    bowtie_path = args.bowtie_path.rstrip("/") + "/" if args.bowtie_path else ""

    cmd_parts = [
        f"{_script_dir}/pRSEM/prsem-testing-procedure",
        f"--num-threads {args.num_threads}",
        f"--partition-model {partition_model}",
    ]

    if args.chipseq_peak_file:
        cmd_parts.append(f"--chipseq-peak-file {args.chipseq_peak_file}")
    elif partition_model == "cmb_lgt":
        if args.chipseq_bed_files_multi_targets:
            cmd_parts.append(f"--chipseq-bed-files-multi-targets {args.chipseq_bed_files_multi_targets}")
        elif args.chipseq_read_files_multi_targets:
            cmd_parts.append(f"--chipseq-read-files-multi-targets {args.chipseq_read_files_multi_targets}")
            cmd_parts.append(f"--bowtie-path {bowtie_path}")
    else:
        cmd_parts.append(f"--chipseq-target-read-files {args.chipseq_target_read_files}")
        cmd_parts.append(f"--bowtie-path {bowtie_path}")
        if args.chipseq_control_read_files:
            cmd_parts.append(f"--chipseq-control-read-files {args.chipseq_control_read_files}")

    if args.quiet:
        cmd_parts.append("--quiet")

    cmd_parts.extend([ref_name, sample_name, stat_name, imd_name])
    cmd = " ".join(cmd_parts)
    run_command(cmd)

    if not args.keep_intermediate_files:
        run_command(f"rm -rf {temp_dir}", "Fail to delete the temporary folder!")


if __name__ == "__main__":
    main()
