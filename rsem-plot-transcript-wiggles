#!/usr/bin/env python3
"""
rsem-plot-transcript-wiggles - Generate PDF wiggle plots from transcript or gene ids.

Generates transcript wiggle plots and outputs them in a PDF file.
Uses files generated by rsem-calculate-expression.
"""

import argparse
import os
import sys

_script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _script_dir)
os.environ["PATH"] = os.pathsep.join([
    _script_dir,
    os.path.join(_script_dir, "samtools-1.3"),
    os.environ.get("PATH", ""),
])

from rsem_utils import run_command


def main():
    parser = argparse.ArgumentParser(
        description="Generate PDF wiggle plots from transcript or gene ids.",
    )
    parser.add_argument(
        "--gene-list",
        action="store_true",
        help="Input list is gene ids. (Default: off)",
    )
    parser.add_argument(
        "--transcript-list",
        action="store_true",
        help="Input list is transcript ids (allele-specific only). (Default: off)",
    )
    parser.add_argument(
        "--show-unique",
        action="store_true",
        help="Show stacked bar plots with unique vs multi-reads. (Default: off)",
    )
    parser.add_argument(
        "-p", "--num-threads",
        type=int,
        default=1,
        help="Number of threads. (Default: 1)",
    )
    parser.add_argument(
        "--memory-per-thread",
        default="1G",
        help="Max memory per thread. Accepts K/M/G. (Default: 1G)",
    )
    parser.add_argument(
        "sample_name",
        help="Sample name (from rsem-calculate-expression)",
    )
    parser.add_argument(
        "input_list",
        help="File with transcript or gene ids (one per line)",
    )
    parser.add_argument(
        "output_plot_file",
        help="Output PDF file name",
    )
    args = parser.parse_args()

    sample = args.sample_name
    allele_s = os.path.exists(f"{sample}.alleles.results")

    if not allele_s and args.transcript_list:
        parser.error("--transcript-list cannot be set if allele-specific reference is not built!")
    if args.gene_list and args.transcript_list:
        parser.error("--gene-list and --transcript-list cannot be set at the same time!")

    # Generate transcript.sorted.bam if needed
    if not os.path.exists(f"{sample}.transcript.sorted.bam"):
        cmd = f"samtools sort -@ {args.num_threads} -m {args.memory_per_thread} -o {sample}.transcript.sorted.bam {sample}.transcript.bam"
        run_command(cmd)

    # Generate transcript.readdepth if needed
    if not os.path.exists(f"{sample}.transcript.readdepth"):
        cmd = f"rsem-bam2readdepth {sample}.transcript.sorted.bam {sample}.transcript.readdepth"
        run_command(cmd)

    # If show-unique, generate uniq files
    if args.show_unique:
        if not os.path.exists(f"{sample}.uniq.transcript.bam"):
            cmd = f"rsem-get-unique {args.num_threads} {sample}.transcript.bam {sample}.uniq.transcript.bam"
            run_command(cmd)
        if not os.path.exists(f"{sample}.uniq.transcript.sorted.bam"):
            cmd = f"samtools sort -@ {args.num_threads} -m {args.memory_per_thread} -o {sample}.uniq.transcript.sorted.bam {sample}.uniq.transcript.bam"
            run_command(cmd)
        if not os.path.exists(f"{sample}.uniq.transcript.readdepth"):
            cmd = f"rsem-bam2readdepth {sample}.uniq.transcript.sorted.bam {sample}.uniq.transcript.readdepth"
            run_command(cmd)

    # id_type: 0=allele default, 1=transcript, 2=gene
    if allele_s:
        id_type = 1 if args.transcript_list else (2 if args.gene_list else 0)
    else:
        id_type = 2 if args.gene_list else 1

    cmd = f"rsem-gen-transcript-plots {sample} {args.input_list} {int(allele_s)} {id_type} {int(args.show_unique)} {args.output_plot_file}"
    run_command(cmd)


if __name__ == "__main__":
    main()
