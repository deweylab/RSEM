#!/usr/bin/env python3
"""
rsem-generate-ngvector - Create Ng vector for EBSeq based only on transcript sequences.

Generates the Ng vector required by EBSeq for isoform level differential expression
analysis based on reference sequences only. For de novo assembled transcriptome,
groups isoforms by unmappability measures.
"""

import argparse
import os
import sys

_script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _script_dir)
os.environ["PATH"] = os.pathsep.join([
    os.path.join(_script_dir, "EBSeq"),
    os.environ.get("PATH", ""),
])

from rsem_utils import run_command


def main():
    parser = argparse.ArgumentParser(
        description="Create Ng vector for EBSeq based only on transcript sequences.",
    )
    parser.add_argument(
        "-k",
        type=int,
        default=25,
        help="k mer length. (Default: 25)",
    )
    parser.add_argument(
        "input_fasta",
        help="Fasta file with reference transcripts (e.g. reference_name.transcripts.fa)",
    )
    parser.add_argument(
        "output_name",
        help="Output base name. Ng vector stored as output_name.ngvec",
    )
    args = parser.parse_args()

    cmd = f"rsem-for-ebseq-calculate-clustering-info {args.k} {args.input_fasta} {args.output_name}.ump"
    run_command(cmd)

    cmd = f"rsem-for-ebseq-generate-ngvector-from-clustering-info {args.output_name}.ump {args.output_name}.ngvec"
    run_command(cmd)


if __name__ == "__main__":
    main()
