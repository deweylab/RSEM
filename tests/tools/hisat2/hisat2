#!/usr/bin/env bash
# Stable directory for RSEM's --hisat2-path that execs hisat2 from PATH,
# so the binary itself need not be vendored (mirrors tests/tools/star-2.7.6a/STAR).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Drop this dir from PATH so hisat2 doesn't resolve back to this wrapper.
PATH="$(echo "$PATH" | tr ':' '\n' | grep -vx "$DIR" | paste -sd: -)"
export PATH
if ! command -v hisat2 >/dev/null 2>&1; then
  echo "hisat2 not found on PATH. Install HISAT2 to run HISAT2-based RSEM tests." >&2
  exit 127
fi
exec hisat2 "$@"
