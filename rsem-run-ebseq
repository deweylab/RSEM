#!/usr/bin/env python3
"""
rsem-run-ebseq - Wrapper for EBSeq to perform differential expression analysis.

Performs differential expression analysis on two or more conditions.
Use rsem-control-fdr to control false discovery rate after this program.
"""

import argparse
import os
import sys

_script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _script_dir)
os.environ["PATH"] = os.pathsep.join([
    os.path.join(_script_dir, "EBSeq"),
    os.environ.get("PATH", ""),
])

from rsem_utils import run_command


def main():
    parser = argparse.ArgumentParser(
        description="Wrapper for EBSeq to perform differential expression analysis.",
    )
    parser.add_argument(
        "--ngvector",
        default="",
        help="Grouping info for isoform-level analysis (from rsem-generate-ngvector). Default: off",
    )
    parser.add_argument(
        "data_matrix",
        help="m x n matrix file (genes/transcripts x samples). Use rsem-generate-data-matrix to create.",
    )
    parser.add_argument(
        "conditions",
        help="Comma-separated replicate counts per condition (e.g. 3,3 or 2,3,3)",
    )
    parser.add_argument(
        "output_file",
        help="Output file name",
    )
    args = parser.parse_args()

    if args.ngvector == "#":
        parser.error("ngvector file cannot be named as #! # is reserved for other purpose!")

    conditions = args.conditions.split(",")
    if len(conditions) < 2:
        parser.error("At least 2 conditions are required for differential expression analysis!")

    ngv = args.ngvector if args.ngvector else "#"
    cmd = f"rsem-for-ebseq-find-DE {_script_dir}/EBSeq {ngv} {args.data_matrix} {args.output_file} {' '.join(conditions)}"
    run_command(cmd)


if __name__ == "__main__":
    main()
