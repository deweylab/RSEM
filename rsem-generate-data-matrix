#!/usr/bin/env python3
"""
rsem-generate-data-matrix - Generate data matrix from RSEM expression result files.

Extracts expected_count columns from result files to form a matrix for EBSeq.
All result files must have the same file type (alleles, genes, or isoforms).
"""

import sys


def load_data(filename, offset):
    """Load expected_count and ids from a result file. Returns (ids, expected_counts)."""
    ids = []
    ecs = []
    with open(filename) as f:
        next(f)  # skip header
        for line in f:
            line = line.rstrip("\n")
            fields = line.split("\t")
            ids.append(f'"{fields[0]}"')
            ecs.append(fields[offset])
    if not ecs:
        print(f"Nothing is detected! {filename} may not exist or is empty.", file=sys.stderr)
        sys.exit(-1)
    return ids, ecs


def main():
    if len(sys.argv) < 2:
        print(
            "Usage: rsem-generate-data-matrix sampleA.[alleles/genes/isoforms].results "
            "sampleB.[alleles/genes/isoforms].results ... > output_name.matrix",
            file=sys.stderr,
        )
        print(
            "All result files should have the same file type. "
            "The 'expected_count' columns of every result file are extracted to form the data matrix.",
            file=sys.stderr,
        )
        sys.exit(-1)

    offset = 5 if sys.argv[1].endswith("alleles.results") else 4
    files = sys.argv[1:]
    n = len(files)

    ids_arr = None
    matrix = []

    for i, filename in enumerate(files):
        ids, ecs = load_data(filename, offset)

        if ids_arr is None:
            ids_arr = ids
            m = len(ids)
        elif ids_arr != ids:
            print("Number of lines among samples are not equal!", file=sys.stderr)
            sys.exit(-1)

        colname = filename[2:] if filename.startswith("./") else filename
        colname = f'"{colname}"'
        row = [colname] + ecs
        matrix.append(row)

    # Output: first column is ids, then each sample's column
    ids_header = [""] + ids_arr
    matrix = [ids_header] + matrix

    for i in range(len(ids_arr) + 1):
        row = [matrix[j][i] for j in range(n + 1)]
        print("\t".join(row))


if __name__ == "__main__":
    main()
