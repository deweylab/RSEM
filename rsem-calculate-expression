#!/usr/bin/env python3
"""
rsem-calculate-expression - Estimate gene and isoform expression from RNA-Seq data.

Aligns reads (Bowtie/Bowtie2/STAR/HISAT2) and calculates expression values,
or uses provided SAM/BAM/CRAM alignments.
"""

import argparse
import os
import shutil
import subprocess
import sys
import time

_script_dir = os.path.dirname(os.path.abspath(__file__))
_samtools_dir = os.path.join(_script_dir, "samtools-1.3")
os.environ["PATH"] = os.pathsep.join([_script_dir, _samtools_dir, os.environ.get("PATH", "")])

sys.path.insert(0, _script_dir)
from rsem_utils import run_command, collect_results, show_version_info, has_poly_a

# Constants
BURNIN = 200
NCV = 1000
SAMPLEGAP = 1
CONFIDENCE = 0.95
NSPC = 50
NMB = 1024
GAP = 32

def _perl_rand_seeds(seed, n):
    """Generate n seeds matching Perl's srand($seed); int(rand(1<<32))."""
    # Perl 5.20+ uses drand48; srand(seed) initializes with (seed<<16)+0x330e
    state = (seed << 16) + 0x330E
    seeds = []
    for _ in range(n):
        state = (25214903917 * state + 11) & (2**48 - 1)
        seeds.append(state >> 16)
    return seeds


PRSEM_PARTITION_MODELS = [
    "pk", "pk_lgtnopk", "lm3", "lm4", "lm5", "lm6",
    "nopk_lm2pk", "nopk_lm3pk", "nopk_lm4pk", "nopk_lm5pk",
    "pk_lm2nopk", "pk_lm3nopk", "pk_lm4nopk", "pk_lm5nopk",
    "cmb_lgt",
]


class NoBamAction(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        setattr(namespace, "gen_bam", False)


def main():
    parser = argparse.ArgumentParser(description="Estimate gene and isoform expression from RNA-Seq data.")
    parser.add_argument("--keep-intermediate-files", action="store_true")
    parser.add_argument("--temporary-folder", default="")
    parser.add_argument("--no-qualities", action="store_true", dest="no_qual")
    parser.add_argument("--paired-end", action="store_true")
    parser.add_argument("--strandedness", default="none", choices=["none", "forward", "reverse"])
    parser.add_argument("--alignments", action="store_true", dest="is_alignment")
    parser.add_argument("--fai", default="", dest="faiF")
    parser.add_argument("--tag", default="XM", dest="tagName")
    parser.add_argument("--seed-length", type=int, default=25, dest="L")
    parser.add_argument("--bowtie-path", default="")
    parser.add_argument("--bowtie-n", type=int, default=2, dest="C")
    parser.add_argument("--bowtie-e", type=int, default=99999999, dest="E")
    parser.add_argument("--bowtie-m", type=int, default=200, dest="maxHits")
    parser.add_argument("--bowtie-chunkmbs", type=int, default=0, dest="chunkMbs")
    parser.add_argument("--phred33-quals", action="store_true", dest="phred33")
    parser.add_argument("--phred64-quals", action="store_true", dest="phred64")
    parser.add_argument("--solexa-quals", action="store_true", dest="solexa")
    parser.add_argument("--bowtie2", action="store_true")
    parser.add_argument("--bowtie2-path", default="")
    parser.add_argument("--bowtie2-mismatch-rate", type=float, default=0.1)
    parser.add_argument("--bowtie2-k", type=int, default=200)
    parser.add_argument("--bowtie2-sensitivity-level", default="sensitive",
                        choices=["very_fast", "fast", "sensitive", "very_sensitive"])
    parser.add_argument("--star", action="store_true")
    parser.add_argument("--star-path", default="")
    parser.add_argument("--star-gzipped-read-file", action="store_true")
    parser.add_argument("--star-bzipped-read-file", action="store_true")
    parser.add_argument("--star-output-genome-bam", action="store_true")
    parser.add_argument("--hisat2-hca", action="store_true")
    parser.add_argument("--hisat2-path", default="")
    parser.add_argument("--fragment-length-min", type=int, default=1, dest="minL")
    parser.add_argument("--fragment-length-max", type=int, default=1000, dest="maxL")
    parser.add_argument("--fragment-length-mean", type=float, default=-1, dest="mean")
    parser.add_argument("--fragment-length-sd", type=float, default=0, dest="sd")
    parser.add_argument("--estimate-rspd", action="store_true", dest="estRSPD")
    parser.add_argument("--num-rspd-bins", type=int, default=20, dest="B")
    parser.add_argument("-p", "--num-threads", type=int, default=1, dest="nThreads")
    parser.add_argument("--append-names", action="store_true")
    parser.add_argument("--sampling-for-bam", action="store_true", dest="sampling")
    parser.add_argument("--no-bam-output", action=NoBamAction, nargs=0, dest="gen_bam")
    parser.add_argument("--output-genome-bam", action="store_true", dest="genGenomeBamF")
    parser.add_argument("--sort-bam-by-coordinate", action="store_true")
    parser.add_argument("--sort-bam-by-read-name", action="store_true")
    parser.add_argument("--sort-bam-memory-per-thread", default="1G", dest="sort_bam_memory")
    parser.add_argument("--single-cell-prior", action="store_true")
    parser.add_argument("--calc-pme", action="store_true", dest="calcPME")
    parser.add_argument("--gibbs-burnin", type=int, default=200, dest="BURNIN")
    parser.add_argument("--gibbs-number-of-samples", type=int, default=1000, dest="NCV")
    parser.add_argument("--gibbs-sampling-gap", type=int, default=1, dest="SAMPLEGAP")
    parser.add_argument("--calc-ci", action="store_true", dest="calcCI")
    parser.add_argument("--ci-credibility-level", type=float, default=0.95, dest="CONFIDENCE")
    parser.add_argument("--ci-memory", type=int, default=1024, dest="NMB")
    parser.add_argument("--ci-number-of-samples-per-count-vector", type=int, default=50, dest="NSPC")
    parser.add_argument("--seed", default="NULL")
    parser.add_argument("--run-pRSEM", action="store_true", dest="run_prsem")
    parser.add_argument("--chipseq-target-read-files", default="")
    parser.add_argument("--chipseq-control-read-files", default="")
    parser.add_argument("--chipseq-read-files-multi-targets", default="")
    parser.add_argument("--chipseq-bed-files-multi-targets", default="")
    parser.add_argument("--cap-stacked-chipseq-reads", action="store_true")
    parser.add_argument("--n-max-stacked-chipseq-reads", type=int, default=5)
    parser.add_argument("--chipseq-peak-file", default="")
    parser.add_argument("--partition-model", default="pk")
    parser.add_argument("--time", action="store_true", dest="mTime")
    parser.add_argument("--strand-specific", action="store_true", dest="strand_specific")
    parser.add_argument("--forward-prob", type=float, default=None, dest="probF")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("-q", "--quiet", action="store_true")
    parser.add_argument("args", nargs="*", help="read_file(s) or input ref sample (positional)")

    args = parser.parse_args()

    if args.version:
        show_version_info()

    gen_bam = getattr(args, "gen_bam", True)

    if args.seed != "NULL":
        args.seed = int(args.seed)

    # Validation
    if args.is_alignment:
        if len(args.args) != 3:
            parser.error("Invalid number of arguments!")
        if (args.bowtie_path or args.C != 2 or args.E != 99999999 or args.maxHits != 200 or
                args.phred33 or args.phred64 or args.solexa or args.bowtie2 or args.bowtie2_path or
                args.bowtie2_mismatch_rate != 0.1 or args.bowtie2_k != 200 or
                args.bowtie2_sensitivity_level != "sensitive" or args.star or args.star_path or
                args.star_output_genome_bam):
            parser.error("Aligner options cannot be set if input is SAM/BAM/CRAM format!")
        bowtie = False
    else:
        bowtie = not args.bowtie2 and not args.star and not args.hisat2_hca
        nargs = 4 if args.paired_end else 3
        if len(args.args) != nargs:
            parser.error("Invalid number of arguments!")
        if args.no_qual and (args.phred33 or args.phred64 or args.solexa):
            parser.error("If --no-qualities is set, neither --phred33-quals, --phred64-quals or --solexa-quals can be active!")
        if args.phred33 + args.phred64 + args.solexa > 1:
            parser.error("Only one of --phred33-quals, --phred64-quals, and --solexa-quals can be active!")
        if not bowtie and (args.bowtie_path or args.C != 2 or args.E != 99999999 or args.maxHits != 200):
            parser.error("--bowtie-path, --bowtie-n, --bowtie-e, --bowtie-m cannot be set if bowtie aligner is not used!")
        if not args.bowtie2 and (args.bowtie2_path or args.bowtie2_mismatch_rate != 0.1 or args.bowtie2_k != 200 or args.bowtie2_sensitivity_level != "sensitive"):
            parser.error("--bowtie2-path, --bowtie2-mismatch-rate, --bowtie2-k and --bowtie2-sensitivity-level cannot be set if bowtie2 aligner is not used!")
        if not args.star and (args.star_path or args.star_gzipped_read_file or args.star_bzipped_read_file or args.star_output_genome_bam):
            parser.error("--star-path, --star-gzipped-read-file, --star-bzipped-read-file and --star-output-genome-bam cannot be set if STAR aligner is not used!")
        if not args.hisat2_hca and args.hisat2_path:
            parser.error("--hisat2-path cannot be set if HISAT2 aligner is not used!")
        if args.bowtie2 and (args.bowtie2_mismatch_rate < 0 or args.bowtie2_mismatch_rate > 1):
            parser.error("Mismatch rate must be within [0, 1]!")
        if args.bowtie2 and args.bowtie2_sensitivity_level not in ("very_fast", "fast", "sensitive", "very_sensitive"):
            parser.error('Sensitivity level must be one of "very_fast", "fast", "sensitive", and "very_sensitive"!')
        if args.faiF:
            print("Warning: There is no need to set --fai if you ask RSEM to align reads for you.")

    if args.minL < 1:
        parser.error("Min fragment length should be at least 1!")
    if args.minL > args.maxL:
        parser.error("Min fragment length should be smaller or equal to max fragment length!")
    if args.NMB < 1:
        parser.error("The memory allocated for calculating credibility intervals should be at least 1 MB!")
    if args.nThreads < 1:
        parser.error("Number of threads should be at least 1!")
    if args.L < 5:
        parser.error("Seed length should be at least 5!")
    if args.sampling and not gen_bam:
        parser.error("--sampling-for-bam cannot be specified if --no-bam-output is specified!")
    if args.genGenomeBamF and not gen_bam:
        parser.error("--output-genome-bam cannot be specified if --no-bam-output is specified!")
    if args.seed != "NULL" and (args.seed < 0 or args.seed > 0xFFFFFFFF):
        parser.error("The seed for random number generator must be a non-negative 32bit integer!")
    if args.CONFIDENCE <= 0 or args.CONFIDENCE >= 1:
        parser.error("The credibility level should be within (0, 1)!")

    # pRSEM validation
    if args.run_prsem:
        msg = ""
        if (not args.chipseq_peak_file and
            (not args.chipseq_target_read_files or not args.chipseq_control_read_files or not args.bowtie_path) and
            (not args.chipseq_read_files_multi_targets or not args.bowtie_path) and
            not args.chipseq_bed_files_multi_targets):
            msg = "please define one set of the following options to run pRSEM:\n" + (
                "1. --chipseq-peak-file <string>\n"
                "2. --chipseq-target-read-files <string> and --chipseq-control-read-files <string> and --bowtie-path <path>\n"
                "3. --chipseq-read-files-multi-targets <string> and --bowtie-path <path>\n"
                "4. --chipseq-bed-files-multi-targets <string>\n"
            )
        elif args.partition_model in PRSEM_PARTITION_MODELS:
            if args.partition_model == "cmb_lgt" and not args.chipseq_read_files_multi_targets and not args.chipseq_bed_files_multi_targets:
                msg = "either --chipseq-read-files-multi-targets or --chipseq-bed-files-multi-targets needs to be defined for pRSEM's partition model: 'cmb_lgt'"
            elif args.partition_model not in ("pk", "cmb_lgt") and (not args.chipseq_target_read_files or not args.chipseq_control_read_files or not args.bowtie_path):
                msg = "--chipseq-target-read-files and --chipseq-control-read-files and --bowtie-path need to be defined for pRSEM's partition model: '" + args.partition_model + "'"
        else:
            msg = "--partition-model must be one of [" + ", ".join(PRSEM_PARTITION_MODELS) + "]"
        if msg:
            parser.error(msg)

    partition_model = args.partition_model
    if partition_model != "cmb_lgt" and (args.chipseq_read_files_multi_targets or args.chipseq_bed_files_multi_targets):
        print("\nCombining signals from multiple sources, partition model is set to 'cmb_lgt'\n")
        partition_model = "cmb_lgt"

    if args.L < 25:
        print("Warning: the seed length set is less than 25! This is only allowed if the references are not added poly(A) tails.")

    # Forward probability
    probF = args.probF
    if probF is None:
        if args.strandedness == "forward" or (args.strandedness == "none" and args.strand_specific):
            probF = 1.0
        elif args.strandedness == "reverse":
            probF = 0.0
        else:
            probF = 0.5
    if probF < 0 or probF > 1:
        parser.error("Forward probability should be in [0, 1]!")

    # Read type: 0=SE no qual, 1=SE qual, 2=PE no qual, 3=PE qual
    if args.paired_end:
        read_type = 2 if args.no_qual else 3
    else:
        read_type = 0 if args.no_qual else 1

    # Parse positional args
    a = args.args
    if len(a) == 3:
        if args.is_alignment:
            inpF = a[0]
        else:
            mate1_list = a[0]
        ref_name = a[1]
        sample_name = a[2]
    else:
        mate1_list = a[0]
        mate2_list = a[1]
        ref_name = a[2]
        sample_name = a[3]
        inpF = ""

    if (os.path.exists(f"{ref_name}.ta") and not os.path.exists(f"{ref_name}.gt")) or \
       (not os.path.exists(f"{ref_name}.ta") and os.path.exists(f"{ref_name}.gt")):
        print("Allele-specific expression related reference files are corrupted!")
        sys.exit(-1)

    allele_s = os.path.exists(f"{ref_name}.ta") and os.path.exists(f"{ref_name}.gt")

    if args.star and has_poly_a(f"{ref_name}.seq"):
        parser.error("RSEM reference cannot contain poly(A) tails if you want to use STAR aligner!")

    if args.genGenomeBamF:
        with open(f"{ref_name}.ti") as f:
            M, ti_type = f.readline().split()
        if int(ti_type) != 0:
            parser.error("No genome information provided, so genome bam file cannot be generated!")

    sample_token = sample_name.split("/")[-1] if "/" in sample_name else sample_name
    temp_dir = args.temporary_folder or f"{sample_name}.temp"
    stat_dir = f"{sample_name}.stat"
    imd_name = f"{temp_dir}/{sample_token}"
    stat_name = f"{stat_dir}/{sample_token}"

    os.makedirs(temp_dir, exist_ok=True)
    os.makedirs(stat_dir, exist_ok=True)

    if not args.is_alignment and not args.no_qual and not (args.phred33 or args.phred64 or args.solexa):
        args.phred33 = True

    mate_minL, mate_maxL = 1, args.maxL

    bowtie_path = (args.bowtie_path.rstrip("/") + "/") if args.bowtie_path else ""
    bowtie2_path = (args.bowtie2_path.rstrip("/") + "/") if args.bowtie2_path else ""
    star_path = (args.star_path.rstrip("/") + "/") if args.star_path else ""
    hisat2_path = (args.hisat2_path.rstrip("/") + "/") if args.hisat2_path else ""

    time_start = time_end = time_alignment = time_rsem = time_ci = 0

    if not args.is_alignment:
        if bowtie:
            cmd = bowtie_path + "bowtie"
            cmd += " -f" if args.no_qual else " -q"
            if args.phred33:
                cmd += " --phred33-quals"
            elif args.phred64:
                cmd += " --phred64-quals"
            elif args.solexa:
                cmd += " --solexa-quals"
            cmd += f" -n {args.C} -e {args.E} -l {args.L}"
            if read_type in (2, 3):
                cmd += f" -I {args.minL} -X {args.maxL}"
            if args.chunkMbs > 0:
                cmd += f" --chunkmbs {args.chunkMbs}"
            if probF == 1.0:
                cmd += " --norc"
            elif probF == 0.0:
                cmd += " --nofw"
            cmd += f" -p {args.nThreads} -a -m {args.maxHits} -S"
            if args.quiet:
                cmd += " --quiet"
            cmd += f" {ref_name}"
            if read_type in (0, 1):
                cmd += f" {mate1_list}"
            else:
                cmd += f" -1 {mate1_list} -2 {mate2_list}"
            cmd += f" 2> {sample_name}.log | samtools view -b -o {imd_name}.bam -"

        elif args.bowtie2:
            cmd = bowtie2_path + "bowtie2"
            cmd += " -f" if args.no_qual else " -q"
            if args.phred33:
                cmd += " --phred33"
            elif args.phred64:
                cmd += " --phred64"
            elif args.solexa:
                cmd += " --solexa-quals"
            sens = {"very_fast": "--very-fast", "fast": "--fast", "sensitive": "--sensitive", "very_sensitive": "--very-sensitive"}[args.bowtie2_sensitivity_level]
            cmd += f" {sens} --dpad 0 --gbar 99999999 --mp 1,1 --np 1 --score-min L,0,-{args.bowtie2_mismatch_rate}"
            if read_type in (2, 3):
                cmd += f" -I {args.minL} -X {args.maxL} --no-mixed --no-discordant"
            if probF == 1.0:
                cmd += " --norc"
            elif probF == 0.0:
                cmd += " --nofw"
            cmd += f" -p {args.nThreads} -k {args.bowtie2_k}"
            if args.quiet:
                cmd += " --quiet"
            cmd += f" -x {ref_name}"
            if read_type in (0, 1):
                cmd += f" -U {mate1_list}"
            else:
                cmd += f" -1 {mate1_list} -2 {mate2_list}"
            cmd += f" 2> {sample_name}.log | samtools view -b -o {imd_name}.bam -"

        elif args.star:
            star_genome_path = os.path.dirname(ref_name)
            cmd = (f"{star_path}STAR --genomeDir {star_genome_path} --outSAMunmapped Within "
                   "--outFilterType BySJout --outSAMattributes NH HI AS NM MD "
                   "--outFilterMultimapNmax 20 --outFilterMismatchNmax 999 --outFilterMismatchNoverLmax 0.04 "
                   "--alignIntronMin 20 --alignIntronMax 1000000 --alignMatesGapMax 1000000 "
                   "--alignSJoverhangMin 8 --alignSJDBoverhangMin 1 --sjdbScore 1 "
                   f"--runThreadN {args.nThreads} --genomeLoad NoSharedMemory "
                   "--outSAMtype BAM Unsorted --quantMode TranscriptomeSAM "
                   "--outSAMheaderHD @HD VN:1.4 SO:unsorted "
                   f"--outFileNamePrefix {imd_name} ")
            if args.star_gzipped_read_file:
                cmd += " --readFilesCommand zcat "
            elif args.star_bzipped_read_file:
                cmd += " --readFilesCommand bzip2 -c "
            if read_type in (0, 1):
                cmd += f" --readFilesIn {mate1_list} "
            else:
                cmd += f" --readFilesIn {mate1_list} {mate2_list}"

        elif args.hisat2_hca:
            cmd = hisat2_path + "hisat2"
            cmd += " -f" if args.no_qual else " -q"
            if args.phred33:
                cmd += " --phred33"
            elif args.phred64:
                cmd += " --phred64"
            elif args.solexa:
                cmd += " --solexa-quals"
            cmd += (f" --rg-id={sample_token} --rg SM:{sample_token} --rg LB:{sample_token} "
                    f"--rg PL:ILLUMINA --rg PU:{sample_token} --new-summary --summary-file {sample_name}.log "
                    f"--met-file {sample_name}.hisat2.met.txt --met 5 --mp 1,1 --np 1 --score-min L,0,-0.1 "
                    "--rdg 99999999,99999999 --rfg 99999999,99999999 --no-spliced-alignment --no-softclip --seed 12345")
            if read_type in (2, 3):
                cmd += " --no-mixed --no-discordant"
            if probF == 1.0:
                cmd += " --norc"
            elif probF == 0.0:
                cmd += " --nofw"
            if args.quiet:
                cmd += " --quiet"
            cmd += f" -p {args.nThreads} -k 10 --secondary -x {ref_name}"
            if read_type in (0, 1):
                cmd += f" -U {mate1_list}"
            else:
                cmd += f" -1 {mate1_list} -2 {mate2_list}"
            cmd += " | samtools view -b -o " + imd_name + ".bam -"
        else:
            print("Impossible --- unknown aligner!!!")
            sys.exit(-1)

        if args.mTime:
            time_start = time.time()
        run_command(cmd)
        if args.mTime:
            time_alignment = int(time.time() - time_start)

        inpF = f"{imd_name}.bam"

        if args.star:
            star_tr_bam = imd_name + "Aligned.toTranscriptome.out.bam"
            os.rename(star_tr_bam, inpF)
            try:
                os.rmdir(imd_name + "_STARtmp/")
            except OSError:
                pass
            star_genome_bam = imd_name + "Aligned.out.bam"
            rsem_star_genome_bam = sample_name + ".STAR.genome.bam"
            if args.star_output_genome_bam:
                os.rename(star_genome_bam, rsem_star_genome_bam)
            else:
                os.unlink(star_genome_bam)
            os.rename(imd_name + "Log.final.out", sample_name + ".log")

    if args.sort_bam_by_read_name:
        sorted_bam = f"{imd_name}.sorted.bam"
        cmd = f"samtools sort -n -@ {args.nThreads} -m {args.sort_bam_memory} -o {sorted_bam} {inpF}"
        run_command(cmd)
        if not args.is_alignment:
            run_command(f"rm -f {inpF}")
        inpF = sorted_bam

    if args.mTime:
        time_start = time.time()

    cmd = f"rsem-parse-alignments {ref_name} {imd_name} {stat_name} {inpF} {read_type}"
    if args.faiF:
        cmd += f" -t {args.faiF}"
    if args.tagName:
        cmd += f" -tag {args.tagName}"
    if args.quiet:
        cmd += " -q"
    run_command(cmd)

    with open(f"{stat_name}.cnt") as f:
        Ns = f.readline().split()
    no_aligned = int(Ns[1]) == 0

    if not no_aligned:
        cmd = f"rsem-build-read-index {GAP}"
        if read_type == 0:
            cmd += f" 0 {'1' if args.quiet else '0'} {imd_name}_alignable.fa"
        elif read_type == 1:
            cmd += f" 1 {'1' if args.quiet else '0'} {imd_name}_alignable.fq"
        elif read_type == 2:
            cmd += f" 0 {'1' if args.quiet else '0'} {imd_name}_alignable_1.fa {imd_name}_alignable_2.fa"
        else:
            cmd += f" 1 {'1' if args.quiet else '0'} {imd_name}_alignable_1.fq {imd_name}_alignable_2.fq"
        run_command(cmd)

    with open(f"{imd_name}.mparams", "w") as f:
        f.write(f"{args.minL} {args.maxL}\n{probF}\n{int(args.estRSPD)}\n{args.B}\n{mate_minL} {mate_maxL}\n{args.mean} {args.sd}\n{args.L}\n")

    # Match Perl's srand/rand (drand48) for identical seeds and expression_ci results
    seeds = []
    if args.seed != "NULL":
        seeds = _perl_rand_seeds(args.seed & 0xFFFFFFFF, 3)

    cmd = f"rsem-run-em {ref_name} {read_type} {sample_name} {imd_name} {stat_name} -p {args.nThreads}"
    if gen_bam:
        cmd += f" -b {inpF}"
        cmd += f" 1 {args.faiF}" if args.faiF else " 0"
        if args.sampling:
            cmd += " --sampling"
        if args.seed != "NULL":
            cmd += f" --seed {seeds[0]}"
    if args.calcPME or args.calcCI:
        cmd += " --gibbs-out"
    if args.append_names:
        cmd += " --append-names"
    if args.quiet:
        cmd += " -q"
    run_command(cmd)

    if allele_s:
        collect_results("allele", f"{imd_name}.allele_res", f"{sample_name}.alleles.results")
    collect_results("isoform", f"{imd_name}.iso_res", f"{sample_name}.isoforms.results")
    collect_results("gene", f"{imd_name}.gene_res", f"{sample_name}.genes.results")

    if gen_bam:
        if args.genGenomeBamF:
            run_command(f"rsem-tbam2gbam {ref_name} {sample_name}.transcript.bam {sample_name}.genome.bam")
        if args.sort_bam_by_coordinate:
            run_command(f"samtools sort -@ {args.nThreads} -m {args.sort_bam_memory} -o {sample_name}.transcript.sorted.bam {sample_name}.transcript.bam")
            run_command(f"samtools index {sample_name}.transcript.sorted.bam")
            if args.genGenomeBamF:
                run_command(f"samtools sort -@ {args.nThreads} -m {args.sort_bam_memory} -o {sample_name}.genome.sorted.bam {sample_name}.genome.bam")
                run_command(f"samtools index {sample_name}.genome.sorted.bam")

    if args.mTime:
        time_rsem = int(time.time() - time_start)

    if args.mTime:
        time_start = time.time()

    if no_aligned:
        print("Since no aligned reads, further steps will not be performed!")
        if not args.keep_intermediate_files:
            run_command(f"rm -rf {temp_dir}", "Fail to delete the temporary folder!")
        if args.mTime:
            with open(f"{sample_name}.time", "w") as f:
                f.write(f"Aligning reads: {time_alignment} s.\nEstimating expression levels: {time_rsem} s.\n")
        sys.exit(0)

    if args.calcPME or args.calcCI:
        cmd = f"rsem-run-gibbs {ref_name} {imd_name} {stat_name} {args.BURNIN} {args.NCV} {args.SAMPLEGAP} -p {args.nThreads}"
        if args.seed != "NULL":
            cmd += f" --seed {seeds[1]}"
        if args.single_cell_prior:
            cmd += " --pseudo-count 0.1"
        if args.quiet:
            cmd += " -q"
        run_command(cmd)

    if args.calcPME or args.calcCI:
        for suffix in ["alleles", "isoforms", "genes"]:
            if allele_s or suffix != "alleles":
                src = f"{sample_name}.{suffix}.results"
                if os.path.exists(src):
                    shutil.move(src, f"{imd_name}.{suffix}.results.bak1")
        if allele_s:
            collect_results("allele", f"{imd_name}.allele_res", f"{sample_name}.alleles.results")
        collect_results("isoform", f"{imd_name}.iso_res", f"{sample_name}.isoforms.results")
        collect_results("gene", f"{imd_name}.gene_res", f"{sample_name}.genes.results")

    if args.calcCI:
        cmd = f"rsem-calculate-credibility-intervals {ref_name} {imd_name} {stat_name} {args.CONFIDENCE} {args.NCV} {args.NSPC} {args.NMB} -p {args.nThreads}"
        if args.seed != "NULL":
            cmd += f" --seed {seeds[2]}"
        if args.single_cell_prior:
            cmd += " --pseudo-count 0.1"
        if args.quiet:
            cmd += " -q"
        run_command(cmd)
        for suffix in ["alleles", "isoforms", "genes"]:
            if allele_s or suffix != "alleles":
                src = f"{sample_name}.{suffix}.results"
                if os.path.exists(src):
                    shutil.move(src, f"{imd_name}.{suffix}.results.bak2")
        if allele_s:
            collect_results("allele", f"{imd_name}.allele_res", f"{sample_name}.alleles.results")
        collect_results("isoform", f"{imd_name}.iso_res", f"{sample_name}.isoforms.results")
        collect_results("gene", f"{imd_name}.gene_res", f"{sample_name}.genes.results")

    if args.mTime:
        time_ci = int(time.time() - time_start)

    if args.run_prsem:
        cmd = (f"{_script_dir}/pRSEM/prsem-calculate-expression --num-threads {args.nThreads} "
               f"--partition-model {partition_model} --gibbs-burnin {args.BURNIN} "
               f"--gibbs-number-of-samples {args.NCV} --gibbs-sampling-gap {args.SAMPLEGAP} ")
        if args.chipseq_peak_file:
            cmd += f"--chipseq-peak-file {args.chipseq_peak_file}"
        elif partition_model == "cmb_lgt":
            if args.chipseq_bed_files_multi_targets:
                cmd += f"--chipseq-bed-files-multi-targets {args.chipseq_bed_files_multi_targets}"
            elif args.chipseq_read_files_multi_targets:
                cmd += f"--chipseq-read-files-multi-targets {args.chipseq_read_files_multi_targets} --bowtie-path {bowtie_path}"
            if args.cap_stacked_chipseq_reads:
                cmd += f" --cap-stacked-chipseq-reads --n-max-stacked-chipseq-reads {args.n_max_stacked_chipseq_reads}"
        else:
            cmd += f"--chipseq-target-read-files {args.chipseq_target_read_files} --bowtie-path {bowtie_path}"
            if args.chipseq_control_read_files:
                cmd += f" --chipseq-control-read-files {args.chipseq_control_read_files}"
        if args.quiet:
            cmd += " --quiet"
        cmd += f" {ref_name} {sample_name} {stat_name} {imd_name}"
        run_command(cmd)

        fiso_res = f"{imd_name}.iso_res"
        fgene_res = f"{imd_name}.gene_res"
        fprsem_iso_res = f"{imd_name}_prsem.iso_res"
        fprsem_gene_res = f"{imd_name}_prsem.gene_res"
        subprocess.run(f"head -8 {fiso_res} > {fprsem_iso_res}", shell=True, check=True)
        subprocess.run(f"tail -5 {fiso_res} >> {fprsem_iso_res}", shell=True, check=True)
        subprocess.run(f"head -7 {fgene_res} > {fprsem_gene_res}", shell=True, check=True)
        subprocess.run(f"tail -4 {fgene_res} >> {fprsem_gene_res}", shell=True, check=True)
        fstat_iso = f"{stat_name}_uniform_prior_1.isoforms.results"
        fstat_gene = f"{stat_name}_uniform_prior_1.genes.results"
        os.rename(f"{sample_name}.isoforms.results", fstat_iso)
        os.rename(f"{sample_name}.genes.results", fstat_gene)
        collect_results("isoform", fprsem_iso_res, f"{sample_name}.isoforms.results")
        collect_results("gene", fprsem_gene_res, f"{sample_name}.genes.results")

    if not args.keep_intermediate_files:
        run_command(f"rm -rf {temp_dir}", "Fail to delete the temporary folder!")

    if args.mTime:
        with open(f"{sample_name}.time", "w") as f:
            f.write(f"Aligning reads: {time_alignment} s.\n")
            f.write(f"Estimating expression levels: {time_rsem} s.\n")
            f.write(f"Calculating credibility intervals: {time_ci} s.\n")


if __name__ == "__main__":
    main()
