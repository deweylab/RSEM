#!/usr/bin/env python3
"""
extract-transcript-to-gene-map-from-trinity - Extract transcript-to-gene map from Trinity FASTA.
"""

import sys


def main():
    if len(sys.argv) != 3:
        print("Usage: extract-transcript-to-gene-map-from-trinity trinity_fasta_file map_file", file=sys.stderr)
        sys.exit(-1)

    input_file = sys.argv[1]
    output_file = sys.argv[2]

    with open(input_file) as inp, open(output_file, "w") as out:
        lines = iter(inp)
        tag = next(lines, None)
        if tag:
            tag = tag.rstrip("\n")

        while tag and tag.startswith(">"):
            tag = tag[1:]
            cnt = 0
            line = next(lines, None)
            while line and not line.startswith(">"):
                cnt += 1
                line = next(lines, None)

            if cnt == 0:
                print(f"Warning: Fasta entry {tag} has an empty sequence, it is omitted.", file=sys.stderr)
            else:
                tid = tag.split()[0]
                pos = tid.rfind("_")
                gid = tid[:pos] if pos >= 0 else tid
                out.write(f"{gid}\t{tid}\n")

            tag = line.rstrip("\n") if line else None


if __name__ == "__main__":
    main()
